      "properties" : {
        "Script Engine" : "Groovy",
        "Script Body" : "import groovy.json.JsonSlurper\nimport groovy.json.JsonOutput\nimport org.apache.commons.io.IOUtils\nimport java.nio.charset.StandardCharsets\nimport org.apache.nifi.processor.io.StreamCallback\n\nflowFile = session.get()\nif (!flowFile) return\n\ndef resultJson = \"\"\ndef innerMap = [:] // [:] groovy 에서 빈 객체를 의미\n\nflowFile = session.write(flowFile, { inputStream, outputStream ->\n    def text = IOUtils.toString(inputStream, StandardCharsets.UTF_8)\n    if (!text) {\n        log.error(\"FlowFile content is empty\")\n        return\n    }\n    def parsed = new JsonSlurper().parseText(text)\n    innerMap = parsed?.data ?: [:]\n\n    def resultMap = [\n        menuDt  : innerMap?.menuDt ?: \"\",\n        inDivCd : innerMap?.inDivCd ?: \"\",\n        menuSq  : innerMap?.menuSq ?: \"\"\n    ]\n\n    resultJson = JsonOutput.toJson(resultMap)\n    outputStream.write(resultJson.getBytes(StandardCharsets.UTF_8))\n} as StreamCallback)\n\n// flowfile.selectMenuSq.data 이름으로 저장.\nflowFile = session.putAttribute(flowFile, \"flowfile.selectMenuSq.data\", JsonOutput.toJson(innerMap))\n\nsession.transfer(flowFile, REL_SUCCESS)\n"
